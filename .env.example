# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Khóa site reCAPTCHA Enterprise đã đăng ký trong Firebase App Check.
# Bắt buộc khi dùng các nút nghiệp vụ Production gọi Cloud Functions.
VITE_FIREBASE_APPCHECK_SITE_KEY="MY_RECAPTCHA_ENTERPRISE_SITE_KEY"

# Chỉ bật riêng trên bản web Production sau khi đã nghiệm thu kho.
VITE_WORKSHOP_STOCK_ENABLED=false

# Chỉ dùng trong .env.staging.local. Thay bằng cấu hình web của dự án staging và site key của dự án đó.
# VITE_STAGING_FIREBASE_CONFIG='{"projectId":"du-nhua-staging","appId":"1:123456789:web:abcdef123456","apiKey":"YOUR_FIREBASE_WEB_API_KEY","authDomain":"du-nhua-staging.firebaseapp.com","firestoreDatabaseId":"legacy"}'
# VITE_STAGING_FIREBASE_APPCHECK_SITE_KEY="YOUR_STAGING_RECAPTCHA_SITE_KEY"
