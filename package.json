{
  "name": "du-nhua-phe-lieu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','server.js']) fs.rmSync(path,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "lint:rules:v2": "eslint docs/FIRESTORE_WORKSHOP_V2_DRAFT.rules",
    "test": "tsx --test firestore.rules.test.ts src/security/accountSecurity.test.ts src/utils/calculations.test.ts src/utils/payroll.test.ts src/modules/phase4b/payrollDomain.test.ts src/modules/phase4b/migrationPreview.test.ts src/modules/phase4c/productionDomain.test.ts src/modules/phase4d/stockDomain.test.ts",
    "test:rules:integration": "tsx firestore.emulator.test.ts",
    "test:rules:v2:integration": "tsx firestore.workshop-v2.emulator.test.ts",
    "test:emulator": "node scripts/run-firestore-emulator-tests.mjs",
    "test:emulator:v2": "node scripts/run-firestore-emulator-tests.mjs test:rules:v2:integration demo-du-nhua-workshop-v2",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run lint:rules && npm test && npm run build",
    "check:full": "npm run check && npm run lint:rules:v2 && npm run test:emulator && npm run test:emulator:v2 && npm run test:e2e"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0"
  }
}
